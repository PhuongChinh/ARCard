# Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL="postgresql://postgres:1234@localhost:5432/arcard"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# App URL (for QR code generation)
APP_URL="http://192.168.100.158:3000"

# File Storage (S3/R2)
USE_S3="false"
AWS_REGION="auto"
AWS_ENDPOINT="https://your-r2-account.r2.cloudflarestorage.com"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_S3_BUCKET="arcard-uploads"
CDN_URL="https://your-cdn-url.com"

# Server
PORT=3001
NODE_ENV="development"
